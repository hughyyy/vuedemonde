{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "allowArbitraryExtensions": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@vuedemonde": ["src/index.ts"],
      "@vuedemonde/*": ["src/*"]
    }
  },
  "include": ["src", "playground", "test"]
}
