{
  "name": "vuedemonde",
  "version": "0.2.1",
  "description": "Lightweight Vue 3 component + design-token library (forked from the Nexus app's custom UI kit)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/vuedemonde.js",
  "module": "./dist/vuedemonde.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vuedemonde.js"
    },
    "./theme.css": "./dist/theme.css",
    "./kit.css": "./dist/kit.css",
    "./vuedemonde.css": "./dist/vuedemonde.css"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build --config vite.lib.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "render:release": "node scripts/render-release.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test:audit": "vitest run --config vitest.audit.config.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.64.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.13",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
